<?xml version="1.0" encoding="utf-8"?>
<!--
  Code coverage for TEdit's own assemblies, including the WPF app.
  coverlet cannot instrument TEdit.dll (Mono.Cecil fails to resolve WPF types),
  so this uses the Microsoft collector that ships with Microsoft.NET.Test.Sdk.
  Usage (from the repo root): dotnet test src/TEdit.Tests/TEdit.Tests.csproj
  with the options settings src/coverage.runsettings and collect "Code Coverage".
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <CodeCoverage>
            <ModulePaths>
              <Include>
                <ModulePath>.*[\\/]TEdit(\.Common|\.Editor|\.Png|\.Terraria)?\.dll$</ModulePath>
              </Include>
            </ModulePaths>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
